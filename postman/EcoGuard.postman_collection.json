                  "pm.collectionVariables.set('tenant_id', pm.response.json().result[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Perfil nodo simulado (LoRaWAN 1.0.3)",
          "request": {
            "method": "POST",
            "url": "{{cs_url}}/api/device-profiles",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceProfile\": {\n    \"tenantId\": \"{{tenant_id}}\",\n    \"name\": \"EcoGuard nodo simulado (LoRaWAN 1.0.3)\",\n    \"region\": \"US915\",\n    \"regionConfigId\": \"us915_1\",\n    \"macVersion\": \"LORAWAN_1_0_3\",\n    \"regParamsRevision\": \"A\",\n    \"supportsOtaa\": true,\n    \"adrAlgorithmId\": \"default\",\n    \"uplinkInterval\": 600,\n    \"payloadCodecRuntime\": \"JS\",\n    \"payloadCodecScript\": \"// Decodificador de ChirpStack v4 para los nodos EcoGuard.\\n// Se pega en: Device profile → Codec → \\\"JavaScript functions\\\".\\n// Formato de la trama: ver EcoGuard-Node/README.md\\n//\\n// Devuelve los campos que lee el webhook del backend: sos, latitude, longitude, battery_mv.\\n\\nfunction decodeUplink(input) {\\n  var b = input.bytes;\\n  if (input.fPort !== 1 || b.length < 3) {\\n    return { errors: [\\\"Trama EcoGuard invalida (puerto \\\" + input.fPort + \\\", \\\" + b.length + \\\" bytes)\\\"] };\\n  }\\n\\n  var banderas = b[0];\\n  var data = {\\n    sos: (banderas & 0x01) !== 0,\\n    cancelado: (banderas & 0x04) !== 0,\\n    battery_mv: b[1] | (b[2] << 8)\\n  };\\n\\n  // Sin fix GPS la trama no trae coordenadas: el backend guarda el punto como nulo\\n  if ((banderas & 0x02) !== 0 && b.length >= 11) {\\n    data.latitude = int32LE(b, 3) / 1e6;\\n    data.longitude = int32LE(b, 7) / 1e6;\\n  }\\n\\n  return { data: data };\\n}\\n\\n// En JavaScript, << trabaja con enteros de 32 bits con signo: las coordenadas negativas salen bien\\nfunction int32LE(b, i) {\\n  return b[i] | (b[i + 1] << 8) | (b[i + 2] << 16) | (b[i + 3] << 24);\\n}\\n\"\n  }\n}"
            },
            "description": "Incluye chirpstack/codec.js. Si cambias el codec, actualízalo también aquí o en la interfaz."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('perfil_sim_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Perfil nodo Heltec real (LoRaWAN 1.1.0)",
          "request": {
            "method": "POST",
            "url": "{{cs_url}}/api/device-profiles",
            "header": [
              {
                "key": "Content-Type",
