      "name": "1. Webhook directo (sin ChirpStack)",
      "description": "Llama al webhook como si fuera ChirpStack, sin pasar por él. Útil para probar solo el backend.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Simula el contador de tramas LoRaWAN: cada envío incrementa fCnt",
              "const fcnt = Number(pm.collectionVariables.get('fcnt') || 0) + 1;",
              "pm.collectionVariables.set('fcnt', fcnt);"
            ]
          }
        }
      ],
