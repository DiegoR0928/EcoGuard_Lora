# Copia este archivo como .env y llénalo. No se sube a git.

# --- ChirpStack en la Raspberry Pi (red del proyecto) -------------------------------------------
# IP de esta PC en la red local: la URL del webhook en ChirpStack es http://<esta IP>:8000/api/webhook/
ALLOWED_HOSTS_EXTRA=192.168.1.81
# Token que ChirpStack debe mandar en la cabecera Authorization: Bearer <token>. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHIRPSTACK_TOKEN=

# --- The Things Network (opcional: docker compose --profile ttn up -d) ---------------------------
# Datos de tu aplicación > Other integrations > MQTT en la consola de TTN.
TTN_HOST=nam1.cloud.thethings.network
TTN_USUARIO=id-de-tu-aplicacion@ttn
TTN_API_KEY=
